# Postgres connection string. Get a free one at https://neon.tech (or any
# managed Postgres — Supabase, Railway, RDS, etc.) and paste it here.
# Neon's connection strings already include ?sslmode=require, which is what
# this app expects for anything that isn't localhost.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign admin session JWTs. Generate a real one before deploying, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
