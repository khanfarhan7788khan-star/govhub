# Postgres connection string. Get a free one at https://neon.tech (or any
# managed Postgres — Supabase, Railway, RDS, etc.) and paste it here.
# Neon's connection strings already include ?sslmode=require, which is what
# this app expects for anything that isn't localhost.
DATABASE_URL=postgresql://neondb_owner:npg_AwHMrVW0Q2ey@ep-royal-cloud-ay5de1ln-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Secret used to sign admin session JWTs. Generate a real one before deploying, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# Your production URL — used for canonical links, Open Graph tags, and the
# generated sitemap.xml. Set this to your real domain once you have one.
NEXT_PUBLIC_SITE_URL=https://govhub.faynx.tech

# Google AdSense publisher ID (starts with ca-pub-). Leave this as the
# placeholder until your AdSense account is approved — ad components render
# a neutral placeholder box instead of a real ad unit until this is set to a
# real value, so nothing fake or policy-violating is ever served.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
